{
  "version": "0.2.0",
  "configurations": [
    
    
    {
      "name": "Python: Attach Local",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "port": 5678,
        "host": "localhost"
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "."
        }
      ]
    },
    {
      "name": "Python: Attach Remote",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "port": 6789,
        "host": "localhost"
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/config"
        }
      ]
    },
    {
      "name": "Python: Attach Remote (2024)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "port": 6790,
        "host": "localhost"
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/config"
        }
      ]
    }
  ]
}
