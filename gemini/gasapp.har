            "text": "{\"popups\":[],\"notices\":[],\"cards\":{\"bill\":{\"title1\":\"이*진님 08월 총 청구요금\",\"title2\":\"12,780\",\"title3\":null,\"title4\":null,\"title5\":null,\"payable\":\"Y\",\"directDebitYn\":null,\"billSendMethodCode\":\"1\",\"history\":[{\"requestYm\":\"2025-06\",\"usageQty\":\"14\",\"chargeAmt\":\"15,910 원\",\"chargeAmtQty\":15910,\"paymentType\":\"카드결제수납\"},{\"requestYm\":\"2025-07\",\"usageQty\":\"17\",\"chargeAmt\":\"18,990 원\",\"chargeAmtQty\":18990,\"paymentType\":\"카드결제수납\"},{\"requestYm\":\"2025-08\",\"usageQty\":\"11\",\"chargeAmt\":\"12,780 원\",\"chargeAmtQty\":12780,\"paymentType\":\" \"}],\"unpayFlag\":false,\"directDebitFlag\":true},\"minwon\":null,\"indication\":null,\"ami\":null,\"electricAmi\":null,\"survey1Target\":\"N\",\"survey2Target\":\"N\",\"amiType\":\"NONE\",\"electricBill\":{\"title1\":null,\"title2\":null,\"phase\":\"phase3\",\"bills\":null},\"mgAmi\":null,\"mgElectricAmi\":null,\"selfCheckPilot\":null,\"selfSafetyInspection\":null},\"cash\":{\"available\":0,\"expire\":0},\"menus\":[{\"name\":\"실시간 요금 계산\",\"icon\":\"static/home1.png\",\"link\":\"pathgasapp://1/charge\"},{\"name\":\"최근 납부 내역\",\"icon\":\"static/home2.png\",\"link\":\"pathgasapp://1/bills/summary?activeIndex=1\"},{\"name\":\"전기 요금 조회\",\"icon\":\"static/home3.png\",\"link\":\"pathgasapp://1/hanbill\"}],\"lifeSections\":[{\"id\":66,\"subject\":\"전기 요금 청구서 가이드\",\"label\":{\"name\":\"가이드\",\"color\":\"#ffb600\"},\"type\":\"D\",\"contents\":[{\"id\":1496,\"subject\":\"한전 고객번호<br/>1분 만에 확인하는 방법\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2024/0910/aaa549d54ae144018e16437298b21873.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1152,\"subject\":\"전기 요금 청구서<br/>신청 전 준비사항\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2023/1101/1b0257997c064d65ac268a28965d5a00.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1154,\"subject\":\"내 청구서 유형<br/>확인하는 방법\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2023/1101/13360720a5f44731ab4398c458032ecd.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1155,\"subject\":\"한전 청구서 유형<br/>종이청구서로 변경하기\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2023/1101/3e27708f98034511942f7c6e8f5c13bb.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1159,\"subject\":\"전기 요금 청구서<br/>신청하는 방법\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2023/1109/07b5864987644391bed79fc329d95822.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1160,\"subject\":\"전화로 청구서 유형<br/>변경하는 방법\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2023/1109/a82c944c7c284152a99c461284d6ca4c.jpeg\",\"type\":\"D\",\"content\":null}]},{\"id\":54,\"subject\":\"가스앱 사용 가이드\",\"label\":{\"name\":\"Tip\",\"color\":\"#00a0e8\"},\"type\":\"D\",\"contents\":[{\"id\":1374,\"subject\":\"이사 예약 서비스<br/>간편한 이사 준비 방법\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2024/0415/2b8b83c668cb4a5cb4d9be9bd51951e8.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":413,\"subject\":\"전화 없이, 가스앱으로<br/>방문서비스 예약하세요\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2021/0427/c812c2b96bd84191b6433268469bd313.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1026,\"subject\":\"통합에코 마일리지로<br/>요금 할인, 현금 인출하기\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2023/0627/707fd599de7641229b169158ec029e86.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":412,\"subject\":\"다양한 요금 조회 방법<br/>상황별로 활용해 보세요\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2021/0427/f5a67f27ace543f5844df0bd4098ac86.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":906,\"subject\":\"청구서 알림이 오지 않을 때<br/>해결 방법!\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2022/1205/607a185de650496ba356aea2538bba61.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":409,\"subject\":\"새롭게 찾아온 <br/>가스앱을 소개합니다\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2021/0427/f07d2610b88c48a9b28885901af6303d.jpeg\",\"type\":\"D\",\"content\":null}]},{\"id\":64,\"subject\":\"생활에 도움되는 정부정책\",\"label\":{\"name\":\"정책정보\",\"color\":\"#68bc00\"},\"type\":\"D\",\"contents\":[{\"id\":1386,\"subject\":\"친환경 보일러로 바꾸면<br/>보조금 60만원 드려요\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2024/0516/2441deb32ab14ccfb1d89c9389aa105f.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1643,\"subject\":\"‘복지멤버십’<br/>가입하셨어요?\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2024/1217/f220cdcf9e2e4338b034e79eb6bd8874.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1623,\"subject\":\"2024 연말정산<br/>더 높아진 소득·세액공제\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2024/1119/d7b9ba44207d41b48f5f74f1a1b8399e.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1391,\"subject\":\"병원 가기 전<br/>3가지만 기억하세요!\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2024/0522/1b4fa1be823c49d28000ed049ae8e931.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1625,\"subject\":\"안전디딤돌 앱으로<br/>부모님 안전도 챙겨요!\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2024/1126/a2a4545249e540eb9321de2f7f1e575a.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":955,\"subject\":\"10년 된 우리집 보일러<br/>친환경 보일러로 교체!\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2023/0201/df7f22b7baea43bfbb7e02b82fa96aad.jpeg\",\"type\":\"D\",\"content\":null}]},{\"id\":46,\"subject\":\"에너지 절약백서\",\"label\":{\"name\":\"절약정보\",\"color\":\"#78b184\"},\"type\":\"D\",\"contents\":[{\"id\":1642,\"subject\":\"겨울철 찌릿찌릿!<br/>정전기 예방법\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2024/1210/a1d6639cd8a647dc89370268038b99a1.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1462,\"subject\":\"돈 벌어가는<br/>창호교체 꿀팁\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2024/0801/96ca4edee74242aaa5ea288914e9d3c6.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1658,\"subject\":\"내가 받을 수 있는<br/>에너지 복지는?\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2025/0113/c53b5ce6b4ea4291911ae159793fdeaf.jpeg\",\"type\":\"D\",\"content\":null},{\"id\":1649,\"subject\":\"쌀뜨물, 그냥 버리나요?<br/>제대로 활용하는 방법!\",\"image\":\"https://cdn-app.gasapp.co.kr/attach/life/2024/1218/09340b31d504414b81406a645e991384.jpeg\",\"type\