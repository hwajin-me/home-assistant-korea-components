            "mimeType": "text/html;charset=UTF-8",
            "size": 81092,
            "text": "\r\n\r\n\r\n\r\n\r\n\r\n<!DOCTYPE html>\r\n\r\n\r\n\r\n<html lang=\"ko\">\r\n<head>\r\n<title>아리수 사이버고객센터 &gt; 요금조회 &gt; 요금조회 및 납부 &gt; 정기분</title>\r\n<link rel=\"shortcut icon\" href=\"/cs/resources/images/cyber/main/faviconcyber.ico\" >\r\n\r\n<!-- 2020.12.02 bhr 웹 표준 수정 -->\r\n\r\n<!-- 2022.12.01 cbd 웹 표준 수정 -->\r\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" >\r\n<meta name=\"viewport\" content=\"width=device-width, minimum-scale=1.0, initial-scale=1.0, maximum-scale=2.0\" >\r\n<meta charset=\"utf-8\">\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<style>\r\n#seoul-common-gnb {height: 45px; }\r\n#seoul-common-gnb .seoul-gnb-holder {max-width: 1200px !important}\r\n@media only screen and (max-width:786px){\r\n\t#seoul-common-gnb{display: none;}\r\n}\r\n\r\n#hideDiv{position:absolute;left:0;top:0;z-index:1}\r\n#hideDiv li{float:left}\r\n#hideDiv a{position:absolute;width:1px;height:1px;top:-50px;overflow:hidden;text-align:center}\r\n#hideDiv a:focus, #hideDiv a:active{position:absolute;top:32px;width:200px;height:auto;padding:5px;background-color:#fff;border:solid 1px #0079c6;color:#0079c6;z-index:2} \r\n\r\n.cursor {cursor: pointer;}\r\n</style>\r\n\r\n<!-- migrate -->\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script src=\"/cs/resources/js/cyber/jquery-1.12.4.min.js\"></script>\r\n<!-- migrate -->\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script>\r\n  //<![CDATA[\r\n        CTX_PATH = \"/cs\";\r\n        $().ready(function(){\r\n        });\r\n        \r\n        var agent = navigator.userAgent.toLowerCase();\r\n        //이벤트 등록을 처리해주는 함수 (크로스 브라우징)\r\n        function _addEvent(element, eventType, handler) {       \r\n            if (window.addEventListener) {\r\n                element.addEventListener(eventType, handler, false)\r\n            } else {\r\n                if (window.attachEvent) { //IE8이하 버전에서\r\n                    element.attachEvent(\"on\" + eventType, handler)\r\n                }\r\n            }\r\n        }\r\n    \t\r\n        function _addBlockEvent() {\r\n            _addEvent(document, \"dragstart\", _stopEvent); //마우스 드래그  방지\r\n            _addEvent(document, \"selectstart\", _stopEvent); //마우스 선택 방지\r\n            _addEvent(document, \"contextmenu\", _stopEvent); //마우스 오른쪽 클릭 시 팝업메뉴 막기\r\n            if (document.body && document.body.style.MozUserSelect != undefined) { \r\n                document.body.style.MozUserSelect = \"none\" //파이어폭스에서 마우스 선택 방지\r\n            }\r\n        }\r\n        \r\n        //기본동작 수행을 금지 Type2\r\n        function _stopEvent(e) {\r\n        \talert(\"오른쪽 버튼은 사용하실 수 없습니다\");\r\n            if (window.event) { //IE            \r\n                window.event.cancelBubble = true; //전파 방지\r\n                window.event.returnValue = false; //기본 동작 수행방지\r\n            }\r\n            //DOM 레벨 2\r\n            if (e && e.stopPropagation && e.preventDefault) {\r\n                e.stopPropagation(); //이벤트 전파 중지\r\n                e.preventDefault(); //기본 동작 수행방지\r\n            }\r\n        }\r\n        function click() {\r\n       \r\n            if (agent.indexOf(\"firefox\") != -1) {\r\n                _addBlockEvent();\r\n            }else {\r\n                if( (event.button==2)||(event.button==3) ) {\r\n                    alert(\"오른쪽 버튼은 사용하실 수 없습니다\");\r\n                    return false;\r\n                }\r\n            }\r\n            \r\n        }\r\n\t\t\r\n        // 마우스 오른쪽 버튼 막기\r\n        document.onmousedown=click;\r\n      //]]>\r\n    </script>\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script src=\"/cs/resources/js/salmon2/common.js\"></script>\r\n\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script src=\"/cs/resources/js/cyber/default.js\"></script>\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script src=\"/cs/resources/js/cyber/commonUtil.js\"></script>\r\n\r\n<!-- 반응형 js -->\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script src=\"//www.seoul.go.kr/seoulgnb/gnb.js\"></script>\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script src=\"/cs/resources/js/cyber/jquery-1.12.4.js\"></script>\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script src=\"/cs/resources/js/cyber/jquery.cycle2.js\"></script>\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script src=\"/cs/resources/js/cyber/menu.js\"></script>\r\n<script src=\"/cs/resources/js/cyber/design.js\"></script>\r\n<script src=\"https://code.jquery.com/ui/1.10.2/jquery-ui.js\"></script>\r\n<!-- 2022.12.01 cbd 웹 표준 수정 -->\r\n<link rel=\"stylesheet\" href=\"https://code.jquery.com/ui/1.10.2/themes/smoothness/jquery-ui.css\" >\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/cs/resources/css/cyber/common.css\" >\r\n\r\n<!-- 반응형 js -->\r\n<!-- 2022.12.01 cbd 웹 표준 수정 -->\r\n\r\n\r\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/cs/resources/css/cyber/jquery-ui.min.css\" >\r\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/cs/resources/css/cyber/layout.css\">\r\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/cs/resources/css/cyber/board.css\" >\r\n\t\r\n\t<!--[if IE 7]> <link rel='stylesheet' href=\"/cs/new/resources/css/cyber/ie7.css\"><![endif]-->\r\n\r\n\r\n\t<!-- 2017.01.13 스핀버튼 삭제를 위한 css추가 -->\r\n\t<!-- <style type=\"text/css\"> -->\r\n\t<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n\t\r\n\t\t<style>\r\n\t\t\t/* input[type=number]::-webkit-inner-spin-button,input[type=number]::-webkit-outer-spin-button\r\n\t\t\t\t{\r\n\t\t\t\t-webkit-appearance: none;\r\n\t\t\t\tmargin: 0;\r\n\t\t\t} */\r\n\t\t\t/* 2020.11.17 bhr 웹 표준 수정 */\r\n\t\t\t#totAmt {\r\n\t\t\t\tline-height: 36px;\r\n\t\t\t\theight: 36px;\r\n\t\t\t}\r\n\r\n\t\t\t#chenapTableTd {\r\n\t\t\t\twidth: 49%;\r\n\t\t\t}\r\n\r\n\t\t\t@media only screen and (max-width:768px){\r\n\t\t\t\t.tax-table .table-type1 tfoot td {\r\n\t\t\t\t\tborder-right: 1px solid #ccc;\r\n\t\t\t\t}\r\n\t\t\t\t#chenapTableTd {\r\n\t\t\t\t\twidth: 100%;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\t@media only screen and (max-width:520px){\r\n\t\t\t\t.table-box .thead-table tbody tr th:first-child, .table-box .thead-table tbody tr td:first-child{\r\n\t\t\t\t\tborder-right: 0px;\r\n\t\t\t\t}\r\n\t\t\t\t#table-box-pc {\r\n\t\t\t\t\tdisplay: none;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t/* 2021.02.15 bhr sms고지 etax연계 추가 */\r\n\t\t</style>\r\n\r\n\r\n\r\n\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/cs/ClipReport4/css/clipreport.css\">\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/cs/ClipReport4/css/cgJungInfoChart.css\">\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/cs/ClipReport4/css/font.css\">\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script src=\"/cs/ClipReport4/js/clipreport.js\"></script>\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script src=\"/cs/ClipReport4/js/jquery-1.11.1.js\"></script>\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script src=\"/cs/ClipReport4/js/UserConfig.js\"></script>\r\n<!-- <style type=\"text/css\"> -->\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<style>\r\n.ui-datepicker-calendar {\r\n\tdisplay: none;\r\n}\r\n\r\n.ui-datepicker .ui-datepicker-header {\r\n\tpadding-top: 8px;\r\n}\r\n.report_paint_div {\r\n\tbackground-color: white;\r\n\toverflow: hidden !important;\r\n}\r\n\r\n</style>\r\n<!-- <script type=\"text/javascript\"> -->\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n<script>\r\n\t//<![CDATA[\r\n\t//2017.08.08 KGH 사이버고객센터 정기분요금조회 차트부분 변경(퓨전차트->클립리포트)\r\n\t$().ready(function() {\r\n\t\tvar resultKey = $('#resultKey').val();\r\n\t\tif (resultKey != \"\") {\r\n\t\t\thtml2xml(resultKey);\r\n\t\t}\r\n\t\t\r\n\t\t//2017.10.13 KGH 정기분요금조회 납기년월 수정\r\n\t\t$(\"#searchNapgiYm\").datepicker({\r\n\t\t\tcloseText: '닫기',\r\n\t\t\tbuttonText: \"납기년월\",\r\n            prevText: '이전달',\r\n            nextText: '다음달',\r\n            currentText: '오늘',\r\n            monthNames: ['1월(JAN)','2월(FEB)','3월(MAR)','4월(APR)','5월(MAY)','6월(JUN)',\r\n                '7월(JUL)','8월(AUG)','9월(SEP)','10월(OCT)','11월(NOV)','12월(DEC)'],\r\n            monthNamesShort: ['1월','2월','3월','4월','5월','6월',\r\n                '7월','8월','9월','10월','11월','12월'],\r\n            dayNames: ['일','월','화','수','목','금','토'],\r\n            dayNamesShort: ['일','월','화','수','목','금','토'],\r\n            dayNamesMin: ['일','월','화','수','목','금','토'],\r\n         \tdateFormat: 'yy-mm',\r\n         \tchangeMonth: true,\r\n            changeYear: true,\r\n            showMonthAfterYear: true,\r\n            showButtonPanel: true,\r\n            /* showOn: 'button', */\r\n            //20231221 CBD 웹접근성 임시 주석\r\n            showOn: 'none',\r\n            closeText: '선택',\r\n            onClose: function(dateText, inst) { \r\n                var month = $(\"#ui-datepicker-div .ui-datepicker-month :selected\").val();\r\n                var year = $(\"#ui-datepicker-div .ui-datepicker-year :selected\").val();\r\n                $(this).datepicker('setDate', new Date(year, month, 1));\r\n            }\r\n\t\t});//2017.10.13 KGH 정기분요금조회 납기년월 수정\r\n\t\t\r\n\t\t// 경정된 체납분 확인\r\n\t\tif($(\"#chenapCheck\").val() != null) {\r\n\t\t\talert(\"납기기한 후 경정내역이 있습니다. 해당수도사업소로 문의바랍니다.\\n(남부수도사업소: 02-3146-4400)\");\r\n\t\t}\r\n\t\t\r\n\t\t// 2020.05.21 bhr QRCode 추가 std\r\n \t\tif(($('#levyMonth').val()).length < 2){\r\n\t    \t$('#levyMonth').val('0'+$('#levyMonth').val());\r\n\t    }\r\n\t    \r\n\t    if(($('#levyDay').val()).length < 2){\r\n\t    \t$('#levyDay').val('0'+$('#levyDay').val());\r\n\t    }\r\n\r\n\t    var qrCodeUrl = document.location.protocol + \"//\" + document.location.host+\"/cs/com/qrcode/getQrCode.do?OCRBand1=\"+$('#ocrBand1').val()+\r\n\t    \t\t\"&OCRBand2=\"+$('#ocrBand2').val()+\"&OCRBand3=\"+$('#levyYear').val()+$('#levyMonth').val()+$('#levyDay').val()+$('#epayNo').val()+\r\n\t    \t\t\"&OCRBand4=\"+$('#sujunNm').val()+\"&charset=utf-8\";\r\n\t\t$('#qrCodeImg').attr(\"src\", qrCodeUrl);\r\n\t\t// 2020.05.21 bhr QRCode 추가 end\r\n\t\t\r\n\t\tparentCall();\r\n\t\tscrollTop();\r\n\t});\r\n\r\n\tvar urlPath = document.location.protocol + \"//\" + document.location.host;\r\n\r\n\tfunction html2xml(resultKey) {\r\n\t\tvar divPath = \"targetDiv1\";\r\n\t\tvar reportkey = resultKey;\r\n\t\tvar report = createImportJSPReport(urlPath + \"/cs/ClipReport4/Clip.jsp\", reportkey, document.getElementById(divPath));\r\n\t\t\r\n\t\t// urlPath 뒤의 /cs/ClipReport4/Clip.jsp 에서 /cs는 개발과 운영에서만 로컬은 /cs를 빼고서 사용\r\n\t\t//실행\r\n\t\t//report.setSlidePage(true);\r\n\r\n\t\t/* report.setDefaultRatio(\"PageWidth\"); */\r\n\t\treport.setDefaultRatio(\"WholePage\");\r\n\t\treport.setVisibleMenu(false);\r\n\t\treport.view();\r\n\r\n\t\twindow.onresize = function() {\r\n\t\t\tif (null != report) {\r\n\t\t\t\treport.reSize();\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\tvar clipReport = $('div#targetDiv1');\r\n\t\tvar clipReportDiv = clipReport.children().first(\"div\");\r\n\t\tclipReportDiv.children(\"iframe\").attr(\"title\", \"그래프 iframe\");\r\n\t\tclipReportDiv.children(\"form\").children(\"input\").attr(\"title\", \"그래프 값\");\r\n\t\tclipReportDiv.children(\"img\").attr(\"alt\", \"그래프 이미지\");\r\n\t\tclipReportDiv.children(\"div.report_paint_div\").attr(\"title\", \"최근 1년간 사용량 그래프 영역\");\r\n\r\n\t\tvar clipReport2 = $('div.report_menu_table_td_div');\r\n\t\tclipReport2.children(\"nobr\").children(\"span\").children(\"img\").attr(\"alt\", \"그래프 로딩이미지\");\r\n\t\t\r\n\t\t/* $(\"iframe\").remove(); */\r\n\t\t$(\"iframe\").eq(1).remove();\r\n\t}\r\n\t//2017.08.08 KGH 사이버고객센터 정기분요금조회 차트부분 변경(퓨전차트->클립리포트)\r\n\r\n\tvar $j = jQuery.noConflict(true);\r\n\r\n\t$j().ready(\r\n\t\t\tfunction() {\r\n\t\t\t\t//날짜 계산\r\n\t\t\t\tvar today = new Date();\r\n\t\t\t\tvar yearVar = today.getFullYear();\r\n\t\t\t\tvar monthVar = today.getMonth() + 1;\r\n\t\t\t\tvar dayVar = today.getDate();\r\n\t\t\t\t\r\n\t\t\t\tvar csNm = $('#_csNm').val();\r\n\t\t\t\tvar mkey = $j('#mkey').val();\r\n\r\n\t\t\t\tvar billPrintPosblDay = \"\";\r\n\t\t\t\tbillPrintPosblDay = '20250809';\r\n\t\t\t\tif (billPrintPosblDay == \"\" || billPrintPosblDay == null) {\r\n\t\t\t\t\tbillPrintPosblDay = 14;\r\n\t\t\t\t} else {\r\n\t\t\t\t\tbillPrintPosblDay = parseInt(billPrintPosblDay.substring(6, 8));\r\n\t\t\t\t}\r\n\r\n\t\t\t\t//14일 기준으로 14일 이후면 현재월 이전이면 전월을 표시\r\n\t\t\t\tif (dayVar < billPrintPosblDay) {\r\n\t\t\t\t\tvar prevDay = new Date(yearVar, monthVar - 1)\r\n\t\t\t\t\tmonthVar = prevDay.getMonth();\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif ('' != '20250701') {\r\n\t\t\t\t\t\t$j('#searchNapgiYm').val('2025-07');\t\r\n\t\t\t\t} else {\r\n\t\t\t\t\t//10보다 작은 월 01,02.... 표시\r\n\t\t\t\t\tif (monthVar < 10) {\r\n\t\t\t\t\t\tmonthVar = '0' + monthVar;\r\n\t\t\t\t\t}\r\n\t\t\t\t\t// 당월이 01월이고, 요금확정전일자(13-15)전이면 전년,전월표시\r\n\t\t\t\t\tif (monthVar == \"00\") {\r\n\r\n\t\t\t\t\t\tyearVar = yearVar - 1;\r\n\t\t\t\t\t\tmonthVar = \"12\";\r\n\t\t\t\t\t}\r\n\t\t\t\t\t$j('#searchNapgiYm').val(yearVar + '-' + monthVar)\r\n\t\t\t\t}\r\n\t\t\t\tif ($('#_csNm').val() != \"\" && $('#_csNm').val() != null && $('#_csNm').val() != \"null\") {\r\n\t\t\t\t\tif ($j('#mkey').val() != \"\" && $j('#mkey').val() != null && $j('#mkey').val() != \"null\") {\r\n\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tjsGetCsNmFlag2();\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t//고지서 년월 표시\r\n\t\t\t\t$j('#yearVar').text(yearVar);\r\n\t\t\t\t$j('#monthVar').text(monthVar);\r\n\r\n\t\t\t\t// 2018-07-25 : 2013년 10월 이전 상세내역 안내\r\n\t\t\t\t\r\n\t\t\t\tif ($j('#searchNapgiYm').val().replace(\"-\", \"\") <= \"201310\") {\r\n\t\t\t\t\talert(\"2013년 10월 이전 자료는 납부 상세내역이 조회되지 않으니 양해해 주시기 바랍니다.\");\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t});\r\n\r\n\tfunction parentCall(){\r\n\t    setTimeout(function() {\r\n\t    \ttry {\r\n\t    \t\tparent.setResponsive();\r\n\t    \t} catch (e) {\r\n\t    \t}\r\n\t    }, 110);\r\n\t}\r\n\r\n\tfunction scrollTop(){\r\n\t\ttry {\r\n\t\t\t parent.scrollTop();\r\n\t\t} catch (e) {\r\n\t\t}\t\r\n\t}\r\n\r\n\r\n\t//정기분 요금조회 전 정기분이 있는지 없는지 확인\r\n\tvar searchBeforeCheck = function() {\r\n\t\tvar mkey = $('#mkey').val();\r\n\t\tvar csNm = $('#csNm').val().replace(/(\\s*)/g, \"\");\r\n\t\tvar searchNapgi = $('#searchNapgiYm').val();\r\n\t\tvar regNumber = /^[0-9]*$/;\r\n\r\n\t\tif ($('#mkey').val() != null || $('#mkey').val() != \"\") {\r\n\t\t\tif (regNumber.test($('#mkey').val()) == false) {\r\n\t\t\t\talert(\"고객번호는 숫자만 입력가능합니다.\");\r\n\t\t\t\tdocument.getElementById(\"searchBtn\").disabled = false; /* 2021.05.31 LSM 연속클릭 방지 */\r\n\t\t\t\treturn;\r\n\t\t\t};\r\n\t\t}\r\n\r\n\t\t$.ajax({\r\n\t\t\ttype : 'POST',\r\n\t\t\turl : '/cs/cyber/front/cgcalc/JR_getpcaDeciFlag.do',\r\n\t\t\tdata : {\r\n\t\t\t\t'searchMkey' : jsLPad(mkey, 9, '0'),\r\n\t\t\t\t'searchCsNm' : csNm,\r\n\t\t\t\t'searchNapgi' : searchNapgi\r\n\t\t\t},\r\n\t\t\tdataType : 'json',\r\n\t\t\tsuccess : function(result) {\r\n\t\t\t\tif (result.pcaDeciFlag == 'Y') {\r\n\t\t\t\t\tjsSearch();\r\n\t\t\t\t} else {\r\n\t\t\t\t\talert('선택하신 납기에 해당하는 요금내역이 없습니다.');\r\n\t\t\t\t\tdocument.getElementById(\"searchBtn\").disabled = false; /* 2021.05.31 LSM 연속클릭 방지 */\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t}\r\n\r\n\t/** 정기분 조회 화면에서 조회버튼 클릭시 */\r\n\tvar jsSearch = function() {\r\n\t\tvar mkey = $('#mkey').val();\r\n\t\tvar searchNapgi = $('#searchNapgiYm').val().replace(\"-\", \"\");\r\n\r\n\t\tif ('' == mkey) {\r\n\t\t\talert('조회하실 고객번호를 입력하세요.');\r\n\t\t\t$('#mkey').focus();\r\n\t\t\tdocument.getElementById(\"searchBtn\").disabled = false; /* 2021.05.31 LSM 연속클릭 방지 */\r\n\t\t\treturn false;\r\n\t\t} else if ('' == $('#csNm').val()) {\r\n\t\t\talert('조회하실 사용자명을 입력하세요.');\r\n\t\t\t$('#csNm').focus();\r\n\t\t\tdocument.getElementById(\"searchBtn\").disabled = false; /* 2021.05.31 LSM 연속클릭 방지 */\r\n\t\t\treturn false;\r\n\t\t}\r\n\r\n\t\tdocument.dataForm.elements[\"searchMkey\"].value = jsLPad(mkey, 9, '0');\r\n\t\tdocument.dataForm.elements[\"searchNapgi\"].value = $('#searchNapgiYm').val();\r\n\t\tdocument.dataForm.elements[\"searchCsNm\"].value = $('#csNm').val();\r\n\t\tdocument.dataForm.action = '/cs/cyber/front/cgcalc/NR_cgJungInfo.do';\r\n\t\tdocument.dataForm.submit();\r\n\t}\r\n\r\n\t/**사용자명 확인2(,정기분조회2)는 사이버고객센터 메인에서 비로그인시 수도요금간편조회시 파라미터3개(mkey, csNm, napgi)를 넘겨 정기분을 바로 조회하도록 하는 것.*/\r\n\tvar jsGetCsNmFlag2 = function() {\r\n\t\tvar mkey = $('#_mkey').val();\r\n\t\tvar csNm = $('#_csNm').val().replace(/(\\s*)/g, \"\");\r\n\t\tvar searchNapgiYm = $('#_napgi').val().replace(\"-\", \"\");\r\n\t\tvar billPrintPosblDay = \"\";\r\n\r\n\t\t$.ajax({\r\n\t\t\ttype : 'POST',\r\n\t\t\turl : '/cs/cyber/front/mkey/searchCgSchd.do',\r\n\t\t\tdata : {'searchNapgiYm' : searchNapgiYm},\r\n\t\t\tdataType : 'json',\r\n\t\t\tsuccess : function(result) {\r\n\t\t\t\tif (result.billPrintPosblDay == \"\" || result.billPrintPosblDay == null) {\r\n\t\t\t\t\tbillPrintPosblDay = 14;\r\n\t\t\t\t} else {\r\n\t\t\t\t\tbillPrintPosblDay = result.billPrintPosblDay;\r\n\t\t\t\t\tbillPrintPosblDay = result.billPrintPosblDay;\r\n\t\t\t\t\tbillPrintPosblDay = parseInt(billPrintPosblDay.substring(6, 8));\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t/** ↓↓↓현재 년월일 구하기↓↓↓ */\r\n\t\t\t\tvar date = new Date();\r\n\r\n\t\t\t\tvar thisYear = date.getFullYear();\r\n\t\t\t\tvar thisMonth = date.getMonth() + 1;\r\n\t\t\t\tvar thisDate = date.getDate();\r\n\r\n\t\t\t\t/* 선택 월이 10월 이전이면 '0' 붙이기 */\r\n\t\t\t\tif (thisMonth < 10) {\r\n\t\t\t\t\tthisMonth = '0' + thisMonth;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tvar searchNapgi = $('#_napgi').val().replace(\"-\", \"\");\r\n\t\t\t\tvar checkYearMonth = thisYear + \"\" + thisMonth;\r\n\r\n\t\t\t\t/* 현재월이 납기년월이고 일자가 고지서출력날자일 이전이면 조회불가능 alert 출력 */\r\n\t\t\t\tif (thisDate < billPrintPosblDay) {\r\n\t\t\t\t\tif (searchNapgi == checkYearMonth) {\r\n\t\t\t\t\t\talert('현재월은 요금이 확정되는 14~15일경부터 조회 가능합니다.');\r\n\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\r\n\t\t\t\t/* 현재월이 납기년월이고 일자가 고지서출력날자일 이전이면 조회불가능 alert 출력 */\r\n\r\n\t\t\t\tif ('' == mkey || null == mkey) {\r\n\t\t\t\t\talert('조회하실 고객번호를 입력하세요.');\r\n\t\t\t\t\t$('#mkey').focus();\r\n\t\t\t\t} else if ('' == csNm || null == csNm) {\r\n\t\t\t\t\talert('조회하실 사용자명을 입력하세요.');\r\n\t\t\t\t\t$('#csNm').focus();\r\n\t\t\t\t} else {\r\n\t\t\t\t\t$.ajax({\r\n\t\t\t\t\t\ttype : 'POST',\r\n\t\t\t\t\t\turl : '/cs/cyber/front/mkey/JR_getCsNmFlag.do',\r\n\t\t\t\t\t\tdata : {\r\n\t\t\t\t\t\t\t'searchCsNm' : csNm,\r\n\t\t\t\t\t\t\t'searchMkey' : jsLPad(mkey, 9, '0')\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t\tdataType : 'json',\r\n\t\t\t\t\t\tsuccess : function(result) {\r\n\t\t\t\t\t\t\tif (result.csNmFlag == 'Y') {\r\n\t\t\t\t\t\t\t\t$.ajax({//정기분 요금조회 전 정기분이 있는지 없는지 확인\r\n\t\t\t\t\t\t\t\t\ttype : 'POST',\r\n\t\t\t\t\t\t\t\t\turl : '/cs/cyber/front/cgcalc/JR_getpcaDeciFlag.do',\r\n\t\t\t\t\t\t\t\t\tdata : {'searchMkey' : jsLPad(mkey, 9, '0'), \r\n\t\t\t\t\t\t\t\t\t\t\t'searchCsNm' : csNm,\r\n\t\t\t\t\t\t\t\t\t\t\t'searchNapgi' : searchNapgi},\r\n\t\t\t\t\t\t\t\t\tdataType : 'json',\r\n\t\t\t\t\t\t\t\t\tsuccess : function(result) {\r\n\t\t\t\t\t\t\t\t\t\tif (result.pcaDeciFlag == 'Y') {\r\n\t\t\t\t\t\t\t\t\t\t\tjsSearch2();\r\n\t\t\t\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\t\t\t\talert('선택하신 납기에 해당하는 요금내역이 없습니다.');\r\n\t\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\talert('입력하신 고객번호의 사용자명이 상이합니다.');\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\r\n\t/** 정기분 조회2 */\r\n\tvar jsSearch2 = function() {\r\n\t\tvar mkey = $('#_mkey').val();\r\n\r\n\t\tdocument.dataForm.elements[\"searchMkey\"].value = jsLPad(mkey, 9, '0');\r\n\t\tdocument.dataForm.elements[\"searchNapgi\"].value = $('#_napgi').val();\r\n\t\tdocument.dataForm.elements[\"searchCsNm\"].value = $('#_csNm').val();\r\n\t\tdocument.dataForm.action = '/cs/cyber/front/cgcalc/NR_cgJungInfo.do';\r\n\t\tdocument.dataForm.submit();\r\n\t}\r\n\r\n\t/** 팝업 : 고객번호 찾기 */\r\n\tvar jsMkeySearchPop = function() {\r\n\t\twindow.open('/cs/cyber/front/mkey/PR_mkeySearch.do', \"고객번호찾기\", \"width=780, height=660, toolbar=no, menubar=no, scrollbars=1, resizable=no\");\t\t// 2020.08.04 bhr 익스플로어 스크롤바 활성화\r\n\t}\r\n\r\n\tvar jsSetCsInfo = function(mkey, csNm) {\r\n\t\t$(\"#mkey\").val(mkey);\r\n\t\t$(\"#csNm\").val(csNm);\r\n\t};\r\n\r\n\t/** 팝업 : 인쇄*/\r\n\tvar jsJungInfoPop = function(mkey, napgi) {\r\n\t\tif (mkey == '') {\r\n\t\t\talert('프린트할 데이터가 없습니다.');\r\n\t\t\treturn false;\r\n\t\t} else {\r\n\t\t\tvar pop_status;\r\n\t\t\t/* pop_status = window.open('/cs/cyber/front/cgcalc/PR_cgJungInfoPrint.do?searchMkey='+ mkey + '&searchNapgi=' + napgi + '', \"정기분\", \"width=780px, height=850px, toolbar=no, menubar=no, scrollbars=yes, resizable=yes\"); */\r\n\t\t\tpop_status = window.open('/cs/cyber/front/cgcalc/PR_cgJungInfoPrint.do?searchMkey='+ mkey + '&searchNapgi=' + napgi + '', \"정기분\", \"width=1010px, height=850px, toolbar=no, menubar=no, scrollbars=yes, resizable=yes\");\r\n\t\t\tpop_status.focus();\r\n\t\t}\r\n\t}\r\n\r\n\t/* 정기분 납부하기 */\r\n\tvar jsNapboo = function() {\r\n\t\tif ($(\"#mkey\").val() == \"\") {\r\n\t\t\talert('고객번호를 입력하세요.');\r\n\t\t\t$(\"#mkey\").focus();\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif ($(\"#csNm\").val() == \"\") {\r\n\t\t\talert('사용자명을 입력하세요.');\r\n\t\t\t$(\"#csNm\").focus();\r\n\t\t\treturn false;\r\n\t\t}\r\n\r\n\t\t// 정기분 요금조회 체크\r\n\t\tvar napbooMoney = $(\"#totAmt\").val();\r\n\t\t\r\n\t\tif (napbooMoney == null) {\r\n\t\t\talert('정기분 요금조회내역이 존재해야만 \\'납부하기\\'가 가능합니다.');\r\n\t\t\treturn false;\r\n\t\t}\r\n\r\n\t\tvar napgiYm = $(\"#searchNapgiYm\").val();\r\n\t\tvar arrayNapgi = napgiYm.split('-');\r\n\t\tvar napgiYear = arrayNapgi[0];\r\n\t\tvar napgiMonth = arrayNapgi[1];\r\n\t\tvar last_day = lastDay(napgiYear, napgiMonth);\r\n\r\n\t\tdocument.jungGiForm.elements['r_mkey'].value = $(\"#mkey\").val();\r\n\t\tdocument.jungGiForm.elements['s_mkey'].value = $(\"#mkey\").val();\r\n\t\tdocument.jungGiForm.elements['napgi'].value = last_day;\r\n\t\tdocument.jungGiForm.submit();\r\n\t};\r\n\r\n\t/* 2021.02.15 bhr sms고지 정기분 납부하기 */\r\n\tvar jsNapbooSms = function() {\r\n\t\tif ($(\"#mkey\").val() == \"\") {\r\n\t\t\talert('고객번호를 입력하세요.');\r\n\t\t\t$(\"#mkey\").focus();\r\n\t\t\treturn false;\r\n\t\t}\r\n\r\n\t\t// 정기분 요금조회 체크\r\n\t\tvar napbooMoney = $(\"#totAmt\").val();\r\n\t\t\r\n\t\tif (napbooMoney == null) {\r\n\t\t\talert('정기분 요금조회내역이 존재해야만 \\'납부하기\\'가 가능합니다.');\r\n\t\t\treturn false;\r\n\t\t}\r\n\r\n\t\t// window.open(\"https://etax.seoul.go.kr/jsp/gojilink.jsp?nap_no=\" + $(\"#mkey\").val());\r\n\t\t// 2021.04.05 bhr url 변경\r\n\t\twindow.open(\"https://etax.seoul.go.kr/m/static/link.html?param=/m/screen/PAY0101M01/qr_All_No/\" + $(\"#mkey\").val());\r\n\t};\r\n\t\r\n\t// 마지막 일자 구하기\r\n\tvar lastDay = function(year, month) {\r\n\t\tvar day = 0;\r\n\t\tswitch (month) {\r\n\t\tcase \"1\":\r\n\t\tcase \"3\":\r\n\t\tcase \"5\":\r\n\t\tcase \"7\":\r\n\t\tcase \"8\":\r\n\t\tcase \"10\":\r\n\t\tcase \"12\":\r\n\t\t\tday = 31;\r\n\t\t\tbreak;\r\n\t\tcase \"2\":\r\n\t\t\tif ((year % 4) == 0) {\r\n\t\t\t\tif ((year % 100) == 0 && (year % 400) != 0) {\r\n\t\t\t\t\tday = 28;\r\n\t\t\t\t} else {\r\n\t\t\t\t\tday = 29;\r\n\t\t\t\t}\r\n\t\t\t} else {\r\n\t\t\t\tday = 28;\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\t\tdefault:\r\n\t\t\tday = 30;\r\n\t\t}\r\n\t\treturn day;\r\n\t};\r\n\r\n\t/* 엔터키 정기분조회 */\r\n\tvar enterSubmit = function() {\r\n\t\tif (window.event.keyCode == '13') {\r\n\t\t\t// 정기분 조회\r\n\t\t\tjsGetCsNmFlag();\r\n\t\t}\r\n\t};\r\n\r\n\t/** 사용자명 확인1(,정기분조회1)은 정기분조회화면에서 mkey와 csNm 그리고 searchNapgiYm을 넣어 조회할 때 */\r\n\tvar jsGetCsNmFlag = function() {\r\n\r\n\t\tvar dayRegExp = /^(19|20)\\d{2}-(0[1-9]|1[012])$/;\r\n\r\n\t\tif (!dayRegExp.test($('#searchNapgiYm').val())) {\r\n\t\t\talert(\"날짜 형식이 맞지 않습니다.\\n YYYY-MM 형식으로 입력해주세요.(예: 2018-06)\");\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar mkey = $('#mkey').val();\r\n\t\tvar csNm = $('#csNm').val().replace(/(\\s*)/g, \"\");\r\n\t\tvar searchNapgiYm = $('#searchNapgiYm').val().replace(\"-\", \"\");\r\n\t\tvar billPrintPosblDay = \"\";\r\n\t\t\r\n\t\tdocument.getElementById(\"searchBtn\").disabled = true; /* 2021.05.31 LSM 연속클릭 방지 */\r\n\r\n\t\t$.ajax({\r\n\t\t\ttype : 'POST',\r\n\t\t\turl : '/cs/cyber/front/mkey/searchCgSchd.do',\r\n\t\t\tdata : {'searchNapgiYm' : searchNapgiYm},\r\n\t\t\tdataType : 'json',\r\n\t\t\tsuccess : function(result) {\r\n\t\t\t\tif (result.billPrintPosblDay == null || result.billPrintPosblDay == \"\") {\r\n\t\t\t\t\tbillPrintPosblDay = 14;\r\n\t\t\t\t} else {\r\n\t\t\t\t\tbillPrintPosblDay = result.billPrintPosblDay;\r\n\t\t\t\t\tbillPrintPosblDay = parseInt(billPrintPosblDay.substring(6, 8));\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t/** ↓↓↓현재 년월일 구하기↓↓↓ */\r\n\t\t\t\tvar date = new Date();\r\n\r\n\t\t\t\tvar thisYear = date.getFullYear();\r\n\t\t\t\tvar thisMonth = date.getMonth() + 1;\r\n\t\t\t\tvar thisDate = date.getDate();\r\n\r\n\t\t\t\t/* 선택 월이 10월 이전이면 '0' 붙이기 */\r\n\t\t\t\tif (thisMonth < 10) {\r\n\t\t\t\t\tthisMonth = '0' + thisMonth;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tvar searchNapgi = $('#searchNapgiYm').val().replace(\"-\", \"\");\r\n\t\t\t\tvar checkYearMonth = thisYear + \"\" + thisMonth;\r\n\r\n\t\t\t\t/* 현재월이 납기년월이고 일자가 고지서출력날자일 이전이면 조회불가능 alert 출력 */\r\n\t\t\t\tif (thisDate < billPrintPosblDay) {\r\n\t\t\t\t\tif (searchNapgi == checkYearMonth) {\r\n\t\t\t\t\t\talert('현재월은 요금이 확정되는 14~15일경부터 조회 가능합니다.');\r\n\t\t\t\t\t\tdocument.getElementById(\"searchBtn\").disabled = false; /* 2021.05.31 LSM 연속클릭 방지 */\r\n\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\r\n\t\t\t\t/* 현재월이 납기년월이고 일자가 고지서출력날자일 이전이면 조회불가능 alert 출력 */\r\n\t\t\t\tif ('' == mkey || null == mkey) {\r\n\t\t\t\t\talert('조회하실 고객번호를 입력하세요.');\r\n\t\t\t\t\t$('#mkey').focus();\r\n\t\t\t\t\tdocument.getElementById(\"searchBtn\").disabled = false; /* 2021.05.31 LSM 연속클릭 방지 */\r\n\t\t\t\t} else if ('' == csNm || null == csNm) {\r\n\t\t\t\t\talert('조회하실 사용자명을 입력하세요.');\r\n\t\t\t\t\t$('#csNm').focus();\r\n\t\t\t\t\tdocument.getElementById(\"searchBtn\").disabled = false; /* 2021.05.31 LSM 연속클릭 방지 */\r\n\t\t\t\t} else {\r\n\t\t\t\t\t$.ajax({\r\n\t\t\t\t\t\ttype : 'POST',\r\n\t\t\t\t\t\turl : '/cs/cyber/front/mkey/JR_getCsNmFlag.do',\r\n\t\t\t\t\t\tdata : {\r\n\t\t\t\t\t\t\t'searchCsNm' : csNm,\r\n\t\t\t\t\t\t\t'searchMkey' : jsLPad(mkey, 9, '0')\r\n\t\t\t\t\t\t},\r\n\t\t\t\t\t\tdataType : 'json',\r\n\t\t\t\t\t\tsuccess : function(result) {\r\n\t\t\t\t\t\t\tif (result.csNmFlag == 'Y') {\r\n\t\t\t\t\t\t\t\tsearchBeforeCheck();\r\n\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\talert('입력하신 고객번호의 사용자명이 상이합니다.');\r\n\t\t\t\t\t\t\t\tdocument.getElementById(\"searchBtn\").disabled = false; /* 2021.05.31 LSM 연속클릭 방지 */\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\t//]]>\r\n\r\n\t//2017.02.15 고객번호, 사용자명, 납기년월 null체크하여 빈값으로 수정\r\n\t\r\n\t\t\r\n\t\t//20250717 CBD 구좌 복사 버튼\r\n\t\tfunction copy(obj) {\r\n\t  \t\tvar copyTxt = $(obj).text();\r\n\t  \t\tnavigator.clipboard.writeText(copyTxt);\r\n\t  \t\talert(\"복사되었습니다.\");\r\n\t\t}\r\n</script>\r\n<style>\r\n\t.ds input{padding-right: 0px !important;}\r\n</style>\r\n\r\n</head>\r\n\r\n<body>\r\n\t<!-- 2017.03.06 kgh 서울특별시 표준 GNB 적용 -->\r\n\t\r\n\t<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n\t<script src=\"/cs/resources/js/cyber/gnb.js\"></script>\r\n\t\r\n\t<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n\t<script src=\"//www.seoul.go.kr/seoulgnb/gnb.js\"></script>\r\n\t<div id=\"hideDiv\">\r\n\t\t<ul>\r\n\t\t\t<li><a href=\"#parent\" title=\"주 메뉴바로가기\">주 메뉴바로가기</a></li>\r\n\t\t\t<li>\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t\t<a href=\"#contents\" title=\"본문바로가기\">본문바로가기</a>\r\n\t\t\t\r\n\t\t\t</li>\r\n\t\t\t<li><a href=\"#kwd\" title=\"검색바로가기\">검색바로가기</a></li>\r\n\t\t</ul>\r\n\t</div>\r\n\t<div id='seoul-common-gnb'></div>\r\n\t<!-- 2017.03.06 kgh 서울특별시 표준 GNB 적용 끝-->\r\n\t\r\n    \r\n\t<div id=\"wrap\" class=\"wrap\">\r\n\t\t<!-- <a href=\"javascript:\" id=\"header1\" name=\"header1\" class=\"hid\">상단메뉴 바로가기</a> -->\r\n\t\t\t\r\n\t\t\t\t\t\r\n\t\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n<!-- 로그인시 우측상단 로그인회원 이름출력위해 세션정보얻기 -->\r\n\r\n\r\n\r\n<!-- 2020.11.17 bhr 웹 표준 수정 -->\r\n\r\n\r\n<meta name=\"referrer\" content=\"strict-origin-when-cross-origin\">\r\n<script>\r\n\t//<![CDATA[\r\n\t//IE 에서 accept-charset=\"euc-kr\" 안먹음 해결\r\n\r\n\t//2017.03.06 KGH GNB 로딩스크립트\r\n\t/* window.onload = function() {\r\n\t\tYjs.Gnb.init('G066', 'seoul-common-gnb')\r\n\t}; */\r\n\twindow.onload = function() {\r\n\t\tvar myCss = {\r\n\t\t\tholder : {\r\n\t\t\t\tmaxwidth : '1200px;' \r\n\t\t\t}\r\n\t\t};\r\n\r\n\t\t//popupOpen();\r\n\t\tYjs.Gnb.init('G066', 'seoul-common-gnb', myCss);\r\n\r\n\t\t//20250311 CBD 세션스토리지 삭제\r\n\t\tvar sessionState = \"\";\r\n\t\tvar lrea = sessionStorage.getItem(\"lreaFlag\");\r\n\t\tif((sessionState == null || sessionState == '') && (lrea == 'Y')){\r\n\t\t\tsessionStorage.clear();\r\n\t\t}\r\n\t}\r\n\t//GNB 로딩스크립트 끝\r\n\r\n\t//2017.08.08 KGH 서울시 통합검색 추가\r\n\tvar searchTotal = function() {\r\n\t\t// 서울시 통합검색 Null 체크\r\n\t\tvar query = document.seoulSearch.elements[\"kwd\"].value;\r\n\r\n\t\tif (query == \"\" || query.length == 0) {\r\n\t\t\talert('서울시 통합 검색어를 입력하세요.');\r\n\t\t\treturn false;\r\n\t\t} else if (!Browser.chrome) {\r\n\t\t\t//chrome일경우에는 form에서 accept-charset=\"euc-kr\"만으로 적용 가능하나 ie의 경우에는 아래와같이 한번더 해줘야함.\r\n\t\t\tdocument.charset = 'EUC-KR';\r\n\t\t}\r\n\t}; //2017.08.08 KGH 서울시 통합검색 추가 끝;; 2017.12.05KGH 서울시 통합검색 URL변경\r\n\r\n\tvar Browser = {\r\n\t\ta : navigator.userAgent.toLowerCase()\r\n\t}\r\n\r\n\tBrowser = {\r\n\t\tie : /*@cc_on true || @*/false,\r\n\t\tie6 : Browser.a.indexOf('msie 6') != -1,\r\n\t\tie7 : Browser.a.indexOf('msie 7') != -1,\r\n\t\tie8 : Browser.a.indexOf('msie 8') != -1,\r\n\t\topera : !!window.opera,\r\n\t\tsafari : Browser.a.indexOf('safari') != -1,\r\n\t\tsafari3 : Browser.a.indexOf('applewebkit/5') != -1,\r\n\t\tmac : Browser.a.indexOf('mac') != -1,\r\n\t\tchrome : Browser.a.indexOf('chrome') != -1,\r\n\t\tfirefox : Browser.a.indexOf('firefox') != -1\r\n\t}\r\n\r\n\t// 기본 Zoom\r\n\tvar nowZoom = 100;\r\n\t// 최대 Zoom\r\n\tvar maxZoom = 120;\r\n\t// 최소 Zoom\r\n\tvar minZoom = 80;\r\n\r\n\t// 화면크기 확대\r\n\tvar jsBrowseSizeUp = function() {\r\n\r\n\t\tif (Browser.chrome) {\r\n\t\t\tif (nowZoom < maxZoom) {\r\n\t\t\t\tnowZoom += 10; // 10 = 25%씩 증가\r\n\t\t\t\tdocument.body.style.zoom = nowZoom + \"%\";\r\n\t\t\t\talert(document.body.style.zoom);\r\n\t\t\t} else {\r\n\t\t\t\talert('최대 확대입니다.');\r\n\t\t\t}\r\n\t\t} else if (Browser.opera) {\r\n\t\t\talert('오페라는 화면크기 기능을 지원하지 않습니다.\\n브라우저 내의 확대/축소 기능을 이용하시기 바랍니다.');\r\n\t\t} else if (Browser.safari || Browser.safari3 || Browser.mac) {\r\n\t\t\talert('사파리, 맥은 화면크기 기능을 지원하지 않습니다.\\n브라우저 내의 확대/축소 기능을 이용하시기 바랍니다.');\r\n\t\t} else if (Browser.firefox) {\r\n\t\t\talert('파이어폭스는 화면크기 기능을 지원하지 않습니다.\\n브라우저 내의 확대/축소 기능을 이용하시기 바랍니다.');\r\n\t\t} else {\r\n\t\t\tif (nowZoom < maxZoom) {\r\n\t\t\t\tnowZoom += 10; //10 = 25%씩 증가\r\n\t\t\t\tdocument.body.style.position = \"relative\";\r\n\t\t\t\tdocument.body.style.zoom = nowZoom + \"%\";\r\n\r\n\t\t\t} else {\r\n\t\t\t\talert('최대 확대입니다.');\r\n\t\t\t}\r\n\t\t}\r\n\t};\r\n\r\n\t// 화면크기 축소\r\n\tvar jsBrowseSizeDown = function() {\r\n\t\tif (Browser.chrome) {\r\n\t\t\tif (nowZoom > minZoom) {\r\n\t\t\t\tnowZoom -= 10; // 10 = 25%씩 증가\r\n\t\t\t\tdocument.body.style.zoom = nowZoom + \"%\";\r\n\t\t\t} else {\r\n\t\t\t\talert('최대 축소입니다.');\r\n\t\t\t}\r\n\t\t} else if (Browser.opera) {\r\n\t\t\talert('오페라는 화면크기 기능을 지원하지 않습니다.\\n브라우저 내의 확대/축소 기능을 이용하시기 바랍니다.');\r\n\t\t} else if (Browser.safari || Browser.safari3 || Browser.mac) {\r\n\t\t\talert('사파리, 맥은 화면크기 기능을 지원하지 않습니다.\\n브라우저 내의 확대/축소 기능을 이용하시기 바랍니다.');\r\n\t\t} else if (Browser.firefox) {\r\n\t\t\talert('파이어폭스는 화면크기 기능을 지원하지 않습니다.\\n브라우저 내의 확대/축소 기능을 이용하시기 바랍니다.');\r\n\t\t} else {\r\n\t\t\tif (nowZoom > minZoom) {\r\n\t\t\t\tnowZoom -= 10; //10 = 25%씩 증가\r\n\t\t\t\tdocument.body.style.position = \"relative\";\r\n\t\t\t\tdocument.body.style.zoom = nowZoom + \"%\";\r\n\t\t\t} else {\r\n\t\t\t\talert('최대 축소입니다.');\r\n\t\t\t}\r\n\t\t}\r\n\t};\r\n\r\n\t// 화면크기 원래대로(100%)\r\n\tvar jsBrowseSizeDefault = function() {\r\n\r\n\t\tnowZoom = 100;\r\n\t\tdocument.body.style.zoom = nowZoom + \"%\";\r\n\t};\r\n\r\n\t/** 팝업 : 고객번호 찾기 */\r\n\tvar jsMkeySearchPopIncHeader = function() {\r\n\t\twindow.open('/cs/cyber/front/mkey/PR_mkeySearchIncHeader.do', \"고객번호찾기\", \"width=768px, height=660px , toolbar=no, menubar=no, scrollbars=yes, resizable=yes\");\r\n\t}\r\n\r\n\t//원격지원\r\n\tfunction remoteService() {\r\n\t\tif (confirm(\"원격지원은 반드시 시스템 담당자와\\n협의된 후에 사용하셔야 합니다.\\n\\n원격지원을 요청 하시겠습니까?\")) {\r\n\t\t\twindow.open(\"http://ihelp.seoul.go.kr/\", \"_blank\");\r\n\t\t\t//2017.12.05 KGH 사이버고객센터의 원격접속링크 URL변경\r\n\t\t}\r\n\t}\r\n\t\r\n\tvar tabKey = function(gnb) {\r\n\t\tif(event.keyCode == 9) {\r\n\t\t\t$(\".tabView\").removeClass(\"on\");\r\n\t\t\t$(\".tabView.\" + gnb).addClass(\"on\");\r\n\t\t\tif(event.shiftKey && gnb == \"\") {\r\n\t\t\t\t$(\".tabView\").removeClass(\"on\");\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t//]]>\r\n</script>\r\n\r\n<!--header-->\r\n<div class=\"header\">\r\n\t<div class=\"login-group\">\r\n\t\t<div>\r\n\t\t\t\r\n\t\t\t<a href=\"#seoul-common-gnb\" onclick=\"jsGoMenu('main');\" title=\"메인화면가기\" >&nbsp;홈</a>\r\n\t\t\t\r\n\t\t\t        ㅣ <a href=\"#seoul-common-gnb\" onclick=\"jsGoMenu('m7');\" title=\"로그인\">로그인</a> \r\n\t\t\t        ㅣ <a href=\"#seoul-common-gnb\" onclick=\"jsGoMenu('m7_2');\" title=\"회원가입\">회원가입</a>\r\n\t\t\t\r\n\t\t\t\r\n\t\t\tㅣ <a href=\"#seoul-common-gnb\"  onclick=\"jsGoMenu('m8');\" title=\"이용안내\">이용안내</a>\r\n\t\t\t\r\n\t\t                ㅣ <a href=\"#seoul-common-gnb\" onclick=\"jsGoMenu('m8_6');\" title=\"사이트맵\">사이트맵</a>\r\n\t\t\t\r\n\t\t\t\r\n\t\t\tㅣ <!-- <a href=\"http://arisu.seoul.go.kr\" target=\"_blank\" title=\"서울시 상수도사업본부 홈페이지 새창켜기\">상수도사업본부</a> --><a href=\"http://arisu.seoul.go.kr\" target=\"_blank\" title=\"서울아리수본부 홈페이지 새창켜기\">서울아리수본부</a>\r\n\t\t\t\r\n\t\t</div>\r\n\t</div>\r\n\t<div class=\"gnb-group\">\r\n\t\t<div>\r\n\t\t\t<h1>\r\n\t\t\t\t\r\n\t\t\t\t<a href=\"#seoul-common-gnb\" onclick=\"jsGoMenu('main');\" onkeyup=\"tabKey('')\" title=\"마이페이지로이동\">\r\n\t\t\t\t\t<img src=\"/cs/resources/images/cyber/common/logo.png\" alt=\"Arisu 아리수 사이버고객센터 로고\" >\r\n\t\t\t\t</a>\r\n\t\t\t</h1>\r\n\t\t\t\r\n                \r\n                <div class=\"gnb\">\r\n\t\t\t\t<ul class=\"parent\" id=\"parent\">\r\n